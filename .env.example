# --- Server ---
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001
WEB_APP_URL=http://localhost:3000
# Comma-separated list of origins allowed to call the dashboard/session API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://xerinpay:xerinpay@localhost:5432/xerinpay?schema=public

# --- Secrets (generate real random values for every environment) ---
# openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-64-hex-chars
JWT_REFRESH_SECRET=replace-with-64-hex-chars
# 32-byte key, base64: openssl rand -base64 32
ENCRYPTION_KEY_BASE64=replace-with-base64-32-bytes

JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# --- Email (SMTP). If unset, emails are logged, not sent. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=XerinPay
EMAIL_FROM_ADDRESS=no-reply@xerinpay.example

# --- Selcom provider (sandbox) ---
SELCOM_API_BASE_URL=https://apigwtest.selcommobile.com
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_MERCHANT_ID=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_DEFAULT=120
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_MAX_PAYMENT_CREATE=30
